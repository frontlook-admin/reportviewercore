                      <CellContents>
                        <Textbox Name="Textbox5">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Label>MTxnTypeVchNo</Label>
                                  <Value>=IIf(Fields!Memo.Value,"[M]","") &amp; Fields!TxnType.Value &amp; Fields!VCHNo.Value</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>9pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox5</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="GLId">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Label>Informations</Label>
                                  <Value>=Code.ConcatenateNonEmptyWithCrLf(
New String() {
(IIf(Fields!DrCr.Value="DR","By","To") &amp; " " &amp; Switch(Fields!TxnType.Value = "JV","Journal",
Fields!TxnType.Value = "CB",Lookup(Fields!CBGLId.Value,Fields!GlId.Value,Fields!GlName.Value, "MGeneralLedgers"),
Fields!TxnType.Value = "SB","Sale Bill",
Fields!TxnType.Value = "PB","Purchae Bill")),
(IIf(Fields!ChequeNo.Value="","",("#" &amp; Fields!ChequeNo.Value)) &amp; " " &amp; IIf(Fields!ChequeDate.Value="01-01-01","",Fields!ChequeDate.Value))
	
 &amp; " " &amp; IIf(Len(Fields!BankNote.Value)&gt;0," ","") &amp; " " &amp; Fields!BankNote.Value,Fields!PayeeNote.Value,Fields!MainNarration.Value,Fields!Narration.Value
})</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>9pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>GLId</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
