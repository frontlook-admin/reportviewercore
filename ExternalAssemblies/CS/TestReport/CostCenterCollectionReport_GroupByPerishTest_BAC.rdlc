                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TxnDate">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!TxnDate.Value</Value>
                                  <Style>
