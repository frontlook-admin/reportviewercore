<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ReportViewerCore.Sample.MAUI"
             x:Class="ReportViewerCore.Sample.MAUI.MainPage"
             x:DataType="local:MainPage"
             Title="ReportViewer MAUI Sample">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <Label Text="ReportViewer MAUI Sample"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
            
            <Label Text="Select a report to view:"
                   FontSize="16"
                   HorizontalOptions="Center" />
            
            <Border Stroke="{StaticResource Primary}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="15"
                    Background="White">
                <VerticalStackLayout Spacing="15">
                    
                    <Label Text="Available Reports"
                           FontSize="18"
                           FontAttributes="Bold" />
                    
                    <Button Text="📄 Simple Report"
                            Command="{Binding ViewReportCommand}"
                            CommandParameter="SimpleReport"
                            HorizontalOptions="Fill" />
                    
                    <Button Text="📊 Trial Balance Report"
                            Command="{Binding ViewReportCommand}"
                            CommandParameter="TrialBalanceReport"
                            HorizontalOptions="Fill" />
                    
                    <Button Text="📋 Data-Driven Report"
                            Command="{Binding ViewReportCommand}"
                            CommandParameter="DataDrivenReport"
                            HorizontalOptions="Fill" />
                    
                </VerticalStackLayout>
            </Border>
            
            <Border Stroke="Gray"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="15"
                    Background="#f0f0f0">
                <VerticalStackLayout Spacing="10">
                    
                    <Label Text="About"
                           FontSize="18"
                           FontAttributes="Bold" />
                    
                    <Label Text="This sample demonstrates the ReportViewer MAUI control for viewing RDLC reports across platforms."
                           LineBreakMode="WordWrap" />
                    
                    <Label Text="Features:"
                           FontAttributes="Bold"
                           Margin="0,10,0,0" />
                    
                    <Label Text="• Load RDLC report definitions" />
                    <Label Text="• Bind data sources" />
                    <Label Text="• Set report parameters" />
                    <Label Text="• Export to PDF, Excel, Word" />
                    <Label Text="• Print support (Windows)" />
                    <Label Text="• Share reports" />
                    
                </VerticalStackLayout>
            </Border>
            
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
